<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#B3B3B3" /> <!-- Warna shadow -->
        </shape>
        <padding
            android:left="4dp"
            android:top="4dp"
            android:right="4dp"
            android:bottom="12dp" />
    </item>

    <!-- Main Content Layer -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#EFFFEC" /> <!-- Warna utama -->
        </shape>
    </item>
</layer-list>
